# Public (safe to expose) — used for canonical URLs, sitemap and OG metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Server-only (never prefixed with NEXT_PUBLIC_)
# Optional: raises GitHub API rate limit for the repositories section. Read-only public scope is enough.
GITHUB_TOKEN=
# Optional: deliver contact messages via Resend (https://resend.com). If unset, messages are validated and logged server-side only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
